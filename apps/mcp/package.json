{
  "name": "@triad/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Triad for agents: an MCP server that checks a payment change, records the trusted contact's answer, shares a decision and verifies evidence files.",
  "bin": {
    "triad-mcp": "./src/server.ts"
  },
  "scripts": {
    "start": "node --import tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@solana/kit": "8.6.0",
    "@triad/evidence": "workspace:*",
    "@x402/core": "2.29.0",
    "@x402/svm": "2.29.0",
    "viem": "2.57.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
