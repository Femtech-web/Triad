{
  "name": "@triad/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The triad command: run a scenario through the release gate, live, and write its evidence file.",
  "bin": {
    "triad": "./src/main.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "triad": "node --env-file-if-exists=../../.env --import tsx src/main.ts"
  },
  "dependencies": {
    "@solana/kit": "8.6.0",
    "@triad/core": "workspace:*",
    "@triad/evidence": "workspace:*",
    "@triad/intel": "workspace:*",
    "@triad/settle": "workspace:*",
    "viem": "2.57.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
